---
import BaseLayout from '@layouts/BaseLayout.astro';
import Footer from '@components/layout/Footer.astro';
import QuizApp from '@components/quiz/QuizApp';
import { DIAGNOSTIC_BOOKING_URL } from '@/config/booking';

// CTA targets; the island applies a /contacts fallback for the bot URL when unset
const botUrl: string | undefined = import.meta.env.PUBLIC_OPORA_BOT_URL;
const bookingUrl: string = DIAGNOSTIC_BOOKING_URL;
---

<BaseLayout
  title="Тест: на що ти зараз опираєшся? · Вікторія Жульова"
  description="Безкоштовний тест із 12 запитань: дізнайся, на що ти опираєшся — на себе чи на інших, де твій дефіцит і який перший крок поверне тобі внутрішню опору."
>
  <!-- Minimal logo-only header (design spec D1): campaign funnel, no site nav -->
  <header class="border-b border-navy-100 bg-white">
    <div class="mx-auto flex h-16 max-w-2xl items-center justify-between px-5 sm:px-6">
      <a href="/" aria-label="На головну" class="transition-opacity hover:opacity-80">
        <img src="/logo.svg" alt="Viktoria Zhulova" width="90" height="50" class="h-10" />
      </a>
      <span class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-navy-600">
        Коуч
      </span>
    </div>
  </header>

  <main class="bg-white">
    <div class="mx-auto min-h-[60vh] w-full max-w-2xl px-5 pb-20 pt-10 sm:px-6 sm:pt-14">
      <QuizApp client:load botUrl={botUrl} bookingUrl={bookingUrl} />
    </div>
  </main>

  <Footer variant="legal" />
</BaseLayout>
