---
// Geo page template component
import EnBaseLayout from '../../layouts/EnBaseLayout.astro';
import ReikiHeader from '../../components/reiki/ReikiHeader.astro';
import ReikiMobileMenu from '../../components/reiki/ReikiMobileMenu.tsx';
import PackagesSection from '../../components/reiki/PackagesSection.astro';
import FaqSection from '../../components/reiki/FaqSection.astro';
import BookingSection from '../../components/reiki/BookingSection.astro';
import ReikiFooter from '../../components/reiki/ReikiFooter.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  bodyHtml: string;
  city: string;
  slug: string;
  otherCities: { slug: string; name: string }[];
}

const { title, description, h1, bodyHtml, city, slug, otherCities } = Astro.props;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": `Reiki Riviera — Viktoria Zhulova (${city})`,
    "description": description,
    "areaServed": city,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": city,
      "addressCountry": "FR"
    },
    "priceRange": "€180–€1120",
    "url": `https://zhulova.com/en/${slug}/`,
    "founder": {
      "@type": "Person",
      "name": "Viktoria Zhulova"
    },
    "availableLanguage": ["en", "ru", "uk"],
    "openingHours": "Mo-Su 09:00-20:00",
    "telephone": "+380634543338",
    "email": "viktoriazhulova@gmail.com"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://zhulova.com/en/"},
      {"@type": "ListItem", "position": 2, "name": "Reiki Riviera", "item": "https://zhulova.com/en/"},
      {"@type": "ListItem", "position": 3, "name": `Reiki in ${city}`, "item": `https://zhulova.com/en/${slug}/`}
    ]
  }
];
---

<EnBaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
>
  <ReikiHeader />
  <ReikiMobileMenu client:media="(max-width: 1024px)" />

  <main>
    <div class="geo-hero">
      <div class="wrap">
        <div class="section-label">{`Reiki · ${city} · in English`}</div>
        <h1>{h1}</h1>
      </div>
    </div>

    <div class="wrap geo-content" set:html={bodyHtml} />

    <PackagesSection />
    <FaqSection />
    <BookingSection />

    <div class="wrap" style="padding: 48px 0;">
      <p style="font-size: 13px; color: var(--text-muted);">Also serving:
        {otherCities.map((c, i) => (
          <span>
            {i > 0 && ' · '}
            <a href={`/en/${c.slug}/`} style="color: var(--text-secondary);">{c.name}</a>
          </span>
        ))}
      </p>
    </div>
  </main>

  <ReikiFooter />
</EnBaseLayout>
