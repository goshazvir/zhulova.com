---
import { testimonials } from '@/data/homePageContent';

// The track renders the testimonials twice so the continuous auto-scroll can
// loop seamlessly (when scroll passes the halfway point we subtract half the
// track width — the content there is identical, so there is no visible jump).
// The second pass is decorative and hidden from assistive tech.
const passes = [
  { clone: false },
  { clone: true },
];
---

<section id="testimonials" class="py-20 bg-gradient-to-br from-white to-sage-50" data-animate>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-navy-900 mb-4">
        Що кажуть мої клієнти
      </h2>
      <p class="text-lg text-navy-700 max-w-3xl mx-auto">
        Реальні відгуки від людей, які довірили мені свій розвиток
      </p>
    </div>

    <div data-tst-root>
      {/* Controls */}
      <div class="flex items-center justify-end gap-3 mb-6">
        <button
          type="button"
          data-tst-prev
          aria-label="Попередній відгук"
          class="w-11 h-11 inline-flex items-center justify-center rounded-full bg-white border border-gray-200 text-navy-600 hover:border-gold-400 hover:text-gold-600 shadow-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          data-tst-next
          aria-label="Наступний відгук"
          class="w-11 h-11 inline-flex items-center justify-center rounded-full bg-white border border-gray-200 text-navy-600 hover:border-gold-400 hover:text-gold-600 shadow-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      {/* Viewport — edge fades are scoped to this wrapper only, so they never
          overlap the controls row above and cannot visually mask the arrows. */}
      <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 left-0 w-8 sm:w-16 bg-gradient-to-r from-white to-transparent z-10"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 w-8 sm:w-16 bg-gradient-to-l from-sage-50 to-transparent z-10"></div>

        <div
          data-tst-viewport
          role="group"
          aria-roledescription="карусель"
          aria-label="Відгуки клієнтів"
          tabindex="0"
          class="tst-viewport overflow-x-auto scroll-smooth focus:outline-none focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-4 focus-visible:ring-offset-white rounded-2xl"
        >
          <div data-tst-track class="flex gap-6 py-4">
            {passes.map((pass) =>
              testimonials.map((testimonial) => (
                <div
                  class="tst-card flex-shrink-0 w-[85%] sm:w-[46%] lg:w-[31.5%] bg-white border border-gray-200 rounded-2xl p-8 shadow-sm hover:border-gold-200 hover:shadow-md transition-all"
                  aria-hidden={pass.clone ? 'true' : undefined}
                >
                  <div class="mb-6">
                    <svg class="w-8 h-8 text-gold-600 opacity-40" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                    </svg>
                  </div>

                  <blockquote class="mb-6">
                    <p class="text-lg text-navy-800 leading-relaxed">
                      {testimonial.quote}
                    </p>
                  </blockquote>

                  <div class="pt-6 border-t border-gray-100">
                    <cite class="not-italic">
                      <div class="font-semibold text-navy-900 mb-1">
                        {testimonial.clientName}
                      </div>
                      <div class="text-sm text-navy-600">
                        {testimonial.role}
                      </div>
                    </cite>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Slim, on-brand scrollbar; hidden on desktop where auto-scroll drives it. */
  .tst-viewport {
    scrollbar-width: thin;
    scrollbar-color: #e8cf74 transparent;
  }
  .tst-viewport::-webkit-scrollbar {
    height: 6px;
  }
  .tst-viewport::-webkit-scrollbar-thumb {
    background: #e8cf74;
    border-radius: 9999px;
  }
  @media (min-width: 1024px) {
    .tst-viewport {
      scrollbar-width: none;
    }
    .tst-viewport::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  import { initTestimonialsCarousel } from './testimonialsCarousel';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initTestimonialsCarousel(), { once: true });
  } else {
    initTestimonialsCarousel();
  }
</script>
