---
import { featuredCourse } from '@/data/homePageContent';
---

<section id="courses" class="py-20 bg-gradient-to-br from-gold-50 to-white" data-animate>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-navy-900 mb-4">
        Мій курс
      </h2>
      <p class="text-lg text-navy-700 max-w-3xl mx-auto">
        Практичні інструменти для самостійного розвитку
      </p>
    </div>

    {/* Featured Course Card */}
    <div class="max-w-4xl md:max-w-2xl lg:max-w-4xl mx-auto">
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden hover:shadow-2xl transition-shadow">
        <div class="grid grid-cols-1 lg:grid-cols-2">
          {/* Left: Course Visual */}
          <div class="relative bg-gradient-to-br from-gold-500 to-gold-600 p-12 flex items-center justify-center overflow-hidden">
            {/* Price pill */}
            <span class="absolute top-6 right-6 inline-flex items-center rounded-full bg-navy-900/90 px-4 py-1.5 text-sm font-semibold text-gold-100 shadow-lg backdrop-blur-sm">
              {featuredCourse.price}
            </span>
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-24 h-24 bg-white/20 rounded-full mb-6 ring-1 ring-white/30">
                {/* Anchor — «опора» / steady support */}
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="5" r="2.25" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.25V21" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 11h7" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 13a8 8 0 0 0 16 0" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 13h2.5M20 13h-2.5" />
                </svg>
              </div>
              <p class="text-sm font-medium uppercase tracking-wider text-white/80 mb-2">
                {featuredCourse.eyebrow}
              </p>
              <h3 class="text-3xl font-serif font-bold text-white mb-4">
                {featuredCourse.title}
              </h3>
              <div class="w-16 h-1 bg-white/30 mx-auto rounded-full"></div>
            </div>
          </div>

          {/* Right: Course Info */}
          <div class="p-8 lg:p-12 flex flex-col justify-center">
            <div class="mb-6">
              <h4 class="text-2xl font-serif font-bold text-navy-900 mb-4">
                {featuredCourse.subtitle}
              </h4>
              <p class="text-lg text-navy-700 leading-relaxed mb-6">
                {featuredCourse.description}
              </p>

              {/* Course Benefits */}
              <ul class="space-y-3 mb-6">
                {featuredCourse.benefits.map((benefit) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-gold-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span class="text-navy-700">{benefit}</span>
                  </li>
                ))}
              </ul>

              <p class="text-sm text-navy-600 mb-8">{featuredCourse.priceNote}</p>
            </div>

            <a
              href={featuredCourse.link}
              class="inline-flex items-center justify-center bg-gold-500 text-navy-900 px-8 py-4 text-lg font-medium rounded-lg hover:bg-gold-400 transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-gold-500 shadow-lg hover:shadow-xl"
            >
              {featuredCourse.ctaText}
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Additional Info */}
    <div class="text-center mt-12">
      <p class="text-navy-600">
        Хочете дізнатися більше про індивідуальну роботу? Зв'яжіться зі мною для персональної консультації.
      </p>
    </div>
  </div>
</section>
