---
// Single vendor-script injection point (spec §2). Included once in
// BaseLayout.astro. Each vendor's tag only renders when its env var is set
// — no-op-safe, mirrors `analyticsConfig.ts`'s `isXEnabled()` checks so a
// missing credential produces zero injected script instead of a broken tag.
//
// Meta Pixel is deliberately NOT loaded here: its init is deferred until
// consent-banner acceptance (spec §8), see `src/lib/metaPixel.ts` /
// `src/lib/consent.ts`.
import { getAnalyticsConfig, isGa4Enabled, isClarityEnabled } from '@lib/analyticsConfig';
import { DEFAULT_CONSENT_STATE } from '@lib/consent';

const { ga4MeasurementId, googleAdsId, clarityProjectId } = getAnalyticsConfig();
const ga4Enabled = isGa4Enabled();
const clarityEnabled = isClarityEnabled();
---

{ga4Enabled && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>
    <script
      is:inline
      define:vars={{ ga4Id: ga4MeasurementId, adsId: googleAdsId, defaultConsent: DEFAULT_CONSENT_STATE }}
    >
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag('js', new Date());
      // Consent Mode v2 defaults — denied for ads, granted for analytics
      // until the consent banner decides otherwise (spec §8).
      gtag('consent', 'default', defaultConsent);
      // Unified Google tag: GA4 + Google Ads conversion tracking share one load.
      gtag('config', ga4Id, { send_page_view: false });
      if (adsId) {
        gtag('config', adsId);
      }
    </script>
  </>
)}

{clarityEnabled && (
  <script is:inline define:vars={{ clarityId: clarityProjectId }}>
    (function (c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function () {
          (c[a].q = c[a].q || []).push(arguments);
        };
      t = l.createElement(r);
      t.async = 1;
      t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', clarityId);
  </script>
)}

<script>
  import { captureUtmParams, createUtmStorage, getStoredUtmParams } from '@lib/utm';
  import { createConsentStorage, getConsentChoice, applyConsent } from '@lib/consent';
  import { trackEvent } from '@lib/analytics';

  const utmStorage = createUtmStorage();
  captureUtmParams(window.location.search, utmStorage);

  // Restore a previously-made consent choice on repeat visits (re-applies
  // gtag consent grants and re-initializes Meta Pixel if accepted before).
  const consentStorage = createConsentStorage();
  const choice = getConsentChoice(consentStorage);
  if (choice) {
    applyConsent(choice);
  }

  const utm = getStoredUtmParams(utmStorage);
  trackEvent('page_view', {
    page_path: window.location.pathname,
    page_referrer: document.referrer || undefined,
    utm_source: utm.utm_source,
    utm_medium: utm.utm_medium,
    utm_campaign: utm.utm_campaign,
  });
</script>
