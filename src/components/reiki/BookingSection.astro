---
// BookingSection.astro — Form container with side text
import BookingForm from './BookingForm.tsx';
---
<section id="book" class="fade-up">
  <div class="wrap">
    <div class="section-label">Begin</div>
    <h2 class="section-title">The first step is a short conversation, not a commitment.</h2>
    <div class="book-grid">
      <BookingForm client:idle />
      <div class="book-side">
        <p>Tell me a little about where you are right now, and I'll suggest whether a single session or a package makes more sense. No pressure either way.</p>
        <p>I reply personally, on WhatsApp, usually the same day.</p>
        <p class="cities-note">Serving Nice · Cannes · Antibes · Monaco · Saint-Tropez — in English</p>
      </div>
    </div>
  </div>
</section>
