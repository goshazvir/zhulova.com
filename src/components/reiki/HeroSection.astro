---
// HeroSection.astro — Full viewport hero from prototype
---
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="hero-eyebrow">Reiki on the French Riviera</div>
      <div class="hero-name">Viktoria<span>Zhulova</span></div>
      <p class="hero-role">Reiki Master & Intuitive Energy Healer · Cannes</p>
      <p class="hero-offer">I help internationals on the Riviera <strong>step out of fight-or-flight and get their sleep, energy and calm back</strong> within 3–4 sessions — through private Reiki in Cannes, at your villa, or at a distance, <strong>even if you're the last person who'd believe in energy work.</strong></p>
      <p class="hero-sub">In English · at your villa, yacht, hotel or my space in Cannes · whether you live here or are here for a week.</p>
      <div class="hero-actions">
        <a href="#book" class="btn-gold">Book a private session <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        <a href="#packages" class="btn-outline">See packages</a>
      </div>
    </div>
    <div class="hero-photo-wrap">
      <div class="hero-photo">
        <img src="/images/reiki/hero-viktoria.webp" alt="Viktoria Zhulova — Reiki Master, Cannes" width="800" height="1000" loading="eager" style="width:100%;height:100%;object-fit:cover;" />
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><strong>Usui Reiki</strong><span>Level I & II</span></div>
        <div class="hero-stat"><strong>10+ years</strong><span>Coaching & energy</span></div>
        <div class="hero-stat"><strong>Cannes</strong><span>In-home & villa</span></div>
        <div class="hero-stat"><strong>English</strong><span>Also RU & UA</span></div>
      </div>
    </div>
  </div>
</section>
